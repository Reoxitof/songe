# Copier en ".env" et remplir les valeurs — NE PAS committer .env

PORT=3000
NODE_ENV=production

# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACE_PAR_UNE_CLE_64_CHARS_MIN

JWT_EXPIRES_IN=7d

# Identifiants du compte administrateur (créé au 1er démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_MotDePasseAdmin_Fort!
